{
    "name": "generoi/gds-rate-limiter",
    "type": "wordpress-muplugin",
    "license": "MIT",
    "description": "Answers 429 to IPs that flood PHP with uncached requests, before WordPress loads, with APCu, Redis or the object cache, and escalates repeat offenders to Fastly or Cloudflare",
    "homepage": "https://github.com/generoi/gds-rate-limiter",
    "authors": [
        {
            "name": "Genero",
            "email": "info@genero.fi"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "laravel/pint": "^1.17",
        "php-stubs/wp-cli-stubs": "^2.11",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^9.0",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "wp-phpunit/wp-phpunit": "^7.0",
        "yoast/phpunit-polyfills": "^2.0"
    },
    "suggest": {
        "ext-apcu": "The fastest store, shared by a server's PHP workers",
        "ext-redis": "A store shared across servers",
        "ext-curl": "Escalating repeat offenders to Fastly or Cloudflare"
    },
    "autoload": {
        "psr-4": {
            "GeneroWP\\RateLimiter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GeneroWP\\RateLimiter\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "pint --test",
        "lint:fix": "pint",
        "test:unit": "phpunit -c phpunit.unit.xml",
        "test:wp-env": "npx wp-env run tests-cli --env-cwd=wp-content/plugins/gds-rate-limiter php vendor/bin/phpunit",
        "stan": "./vendor/bin/phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true
    }
}
