<?xml version="1.0"?>
<!-- Without WordPress: the limiter's logic, the client IP sources, the edge
     blocklists' requests, and the APCu and Redis stores where they're set up. -->
<phpunit
    bootstrap="vendor/autoload.php"
    colors="true"
    beStrictAboutTestsThatDoNotTestAnything="true"
>
    <testsuites>
        <testsuite name="unit">
            <directory suffix="Test.php">tests/Unit</directory>
        </testsuite>
    </testsuites>
</phpunit>
